; Local development defaults. Copy to .env with scripts/setup.ps1.
; Values are INI strings; use double quotes for paths containing spaces.
C7_MYSQL_ENABLED=0
C7_DATA_DIR=".local/data"
C7_DB_HOST=127.0.0.1
C7_DB_PORT=3306
C7_DB_NAME=c7_posture_db
C7_DB_USER=root
C7_DB_PASSWORD=""
; Optional Unix socket for macOS XAMPP:
; C7_DB_SOCKET="/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock"
